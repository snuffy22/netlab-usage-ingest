{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "netlab-usage-ingest",
  "main": "src/entry.py",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "BATCH_RETENTION_DAYS": "30",
    "MAX_BODY_BYTES": "65536"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "netlab-usage",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMISSION_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
  // After validating workers.dev, add:
  // "routes": [{ "pattern": "usage.netlab.tools", "custom_domain": true }]
}
